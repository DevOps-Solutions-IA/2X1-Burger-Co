# === API ===
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000
PUBLIC_PAYMENTS_BASE_URL=http://localhost:3301
DOMAIN=
SSL_EMAIL=
ENABLE_HTTPS=false
CLOUDFLARE_TUNNEL_ENABLED=false
CLOUDFLARE_TUNNEL_HOSTNAME=
CLOUDFLARE_TUNNEL_TOKEN=

# === DATABASE / BACKUPS ===
DATABASE_URL=postgresql://user:password@localhost:5432/inventory_dev?schema=public
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/inventory_test?schema=public
POSTGRES_SERVICE=postgres
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_KEEP_COUNT=14
BACKUP_CRON_SCHEDULE=0 2 * * *

# === AUTH ===
# Generate local-only values with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
REFRESH_TOKEN_COOKIE_NAME=refresh_token
MAX_ACTIVE_REFRESH_TOKENS_PER_USER=5

# === DEFAULT USERS ===
# Generate local-only passwords before running outside development.
ADMIN_EMAIL=admin@2x1burgerco.local
ADMIN_PASSWORD=
CASHIER_EMAIL=cashier@2x1burgerco.local
CASHIER_PASSWORD=
INVENTORY_EMAIL=inventory@2x1burgerco.local
INVENTORY_PASSWORD=
WAITER_EMAIL=waiter@2x1burgerco.local
WAITER_PASSWORD=
WAITER_ACCESS_NAME=Mesero Principal
WAITER_ACCESS_CODE=

# === SOFIA AI ===
SOFIA_AI_PROVIDER=rules
SOFIA_AI_MODE=disabled
SOFIA_AI_MIN_CONFIDENCE=0.82
SOFIA_AI_LOG_PROMPTS=false
SOFIA_AI_REDACT_PERSONAL_DATA=true

DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=12000
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_TOKENS=700

# === WHATSAPP QR GATEWAY FUTURO ===
WHATSAPP_PROVIDER=qr_gateway
WHATSAPP_MODE=receive_only
WHATSAPP_QR_ENABLED=false
WHATSAPP_QR_SESSION_NAME=sofia-main
WHATSAPP_QR_SESSION_PATH=./storage/whatsapp-sessions
WHATSAPP_QR_RECONNECT_ENABLED=true
WHATSAPP_QR_MAX_RECONNECT_ATTEMPTS=5
WHATSAPP_QR_ALLOW_REAL_SEND=false
WHATSAPP_QR_ALLOW_RECEIVE=true
WHATSAPP_QR_SANDBOX_ONLY=true

# === SOFIA QR PILOT RECEIVE_ONLY ===
SOFIA_QR_PILOT_ALLOWLIST_ENABLED=true
SOFIA_QR_PILOT_ALLOWED_PHONES=
SOFIA_QR_PILOT_RECEIVE_ONLY=true
SOFIA_QR_PILOT_REAL_SEND=false

# === LEGACY WHATSAPP INTERNO ===
WHATSAPP_INTERNAL_ENABLED=false
WHATSAPP_AUTH_DIR=/app/data/whatsapp-auth
WHATSAPP_SEND_TIMEOUT_MS=45000

# === LEGACY WHATSAPP GATEWAY / HERMES COMPAT ===
HERMES_BASE_URL=
HERMES_API_TOKEN=
HERMES_WEBHOOK_SECRET=
HERMES_PHONE_NUMBER_ID=
HERMES_TIMEOUT_MS=8000
HERMES_MAX_RETRIES=3

# === SOFIA SAFETY ===
SOFIA_AUTO_REPLY_ENABLED=false
SOFIA_AUTO_SAFE_ENABLED=false
SOFIA_PRODUCTION_ENABLED=false
SOFIA_HUMAN_HANDOFF_ENABLED=true
SOFIA_REPLY_OUTSIDE_HOURS=false
SOFIA_WHATSAPP_RATE_LIMIT_PER_MINUTE=20
SOFIA_WHATSAPP_DEDUP_TTL_MINUTES=1440
WHATSAPP_EXPECTED_ACCOUNT_ID=
WHATSAPP_EXPECTED_BUSINESS_IDENTITY=
WHATSAPP_EXPECTED_SESSION_OWNER=
SOFIA_WHATSAPP_OUTBOUND_HANDLER_ENABLED=false

# === PAYMENTS ===
PAYMENTS_PROVIDER=mock
BOLD_API_KEY=
BOLD_WEBHOOK_SECRET=
BOLD_BASE_URL=https://integrations.api.bold.co
BOLD_TIMEOUT_MS=10000
BOLD_PAYMENT_LINK_TTL_MINUTES=20
CRM_IDENTITY_HASH_SECRET=
NEQUI_MANUAL_ENABLED=true
CASH_ON_DELIVERY_ENABLED=true

# === MAPS / ROUTING ===
DELIVERY_EXTERNAL_PROVIDERS_ENABLED=false
DELIVERY_PROVIDER_PRIMARY=openrouteservice
