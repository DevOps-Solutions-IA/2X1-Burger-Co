FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS base
RUN corepack enable

FROM base AS deps
ARG SOURCE_DATE_EPOCH
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/api/tsconfig.json apps/api/tsconfig.json
COPY apps/api/tsconfig.build.json apps/api/tsconfig.build.json
COPY apps/api/nest-cli.json apps/api/nest-cli.json
COPY prisma prisma
RUN set -eu; \
    for attempt in 1 2 3; do \
      pnpm install --frozen-lockfile && exit 0; \
      test "$attempt" -lt 3 || exit 1; \
      sleep "$((attempt * 2))"; \
    done
RUN PRISMA_GENERATE_SKIP_AUTOINSTALL=1 pnpm exec prisma generate --schema prisma/schema.prisma
RUN find /app -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

FROM deps AS runtime-deps
ARG SOURCE_DATE_EPOCH
RUN pnpm --filter @inventory-fastfood/api deploy --prod --legacy /runtime && \
    mkdir -p /runtime/prisma && \
    cp /app/prisma/schema.prisma /runtime/prisma/schema.prisma && \
    cd /runtime && \
    PRISMA_GENERATE_SKIP_AUTOINSTALL=1 node /runtime/node_modules/prisma/build/index.js \
      generate --schema /runtime/prisma/schema.prisma && \
    rm -f /runtime/node_modules/.modules.yaml /runtime/node_modules/.pnpm-workspace-state-v1.json && \
    find /runtime -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

FROM deps AS build
ARG SOURCE_DATE_EPOCH
WORKDIR /app
COPY apps/api apps/api
RUN pnpm --filter @inventory-fastfood/api build && \
    find /app -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS runner
ARG OCI_REVISION
ARG OCI_CREATED
ARG OCI_VERSION
ARG RELEASE_BUILD_ID
ARG SOURCE_DATE_EPOCH
LABEL org.opencontainers.image.revision=$OCI_REVISION \
      org.opencontainers.image.created=$OCI_CREATED \
      org.opencontainers.image.version=$OCI_VERSION \
      org.opencontainers.image.title="2X1 Burger Co API" \
      org.opencontainers.image.source="inventory-fastfood-system" \
      org.opencontainers.image.description="Inventory Fastfood API release artifact"
WORKDIR /app
ENV NODE_ENV=production
ENV RELEASE_MANIFEST_PATH=/app/release-manifest.json
ENV RELEASE_BUILD_ID=$RELEASE_BUILD_ID
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-v1.22.22 && \
    rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
      /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg
COPY --from=runtime-deps /runtime/node_modules ./node_modules
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY prisma/schema.prisma ./prisma/schema.prisma
COPY prisma/migrations ./prisma/migrations
COPY apps/api/package.json ./apps/api/package.json
COPY prisma/seed.ts prisma/beverage-catalog.ts ./prisma/
COPY .release/release-manifest.json ./release-manifest.json
# Crear directorios que necesita escritura y asignar permisos al usuario node
RUN mkdir -p /app/data/whatsapp-auth /app/data/sofia-whatsapp-auth /app/backups && \
    chown -R node:node /app/data /app/backups && \
    find /app/data /app/backups -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +
EXPOSE 3000
USER node
CMD ["node", "apps/api/dist/main.js"]
