FROM node:22-alpine AS base
RUN corepack enable

FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/api/tsconfig.json apps/api/tsconfig.json
COPY apps/api/tsconfig.build.json apps/api/tsconfig.build.json
COPY apps/api/nest-cli.json apps/api/nest-cli.json
COPY prisma prisma
RUN pnpm install --frozen-lockfile
RUN PRISMA_GENERATE_SKIP_AUTOINSTALL=1 pnpm exec prisma generate --schema prisma/schema.prisma

FROM deps AS build
WORKDIR /app
COPY apps/api apps/api
RUN pnpm --filter @inventory-fastfood/api build

FROM node:22-alpine AS runner
RUN corepack enable
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY prisma/schema.prisma ./prisma/schema.prisma
COPY prisma/migrations ./prisma/migrations
COPY apps/api/package.json ./apps/api/package.json
# Crear directorios que necesita escritura y asignar permisos al usuario node
RUN mkdir -p /app/data/whatsapp-auth /app/backups && \
    chown -R node:node /app/data /app/backups
EXPOSE 3000
USER node
CMD ["node", "apps/api/dist/main.js"]
