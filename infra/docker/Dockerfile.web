FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS base
RUN corepack enable

FROM base AS deps
ARG SOURCE_DATE_EPOCH
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/web/tsconfig.json apps/web/tsconfig.json
COPY apps/web/next.config.ts apps/web/next.config.ts
COPY apps/web/postcss.config.mjs apps/web/postcss.config.mjs
COPY apps/web/tailwind.config.ts apps/web/tailwind.config.ts
COPY apps/web/next-env.d.ts apps/web/next-env.d.ts
RUN pnpm install --frozen-lockfile
RUN find /app -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

FROM deps AS build
ARG SOURCE_DATE_EPOCH
ARG NEXT_SERVER_ACTIONS_ENCRYPTION_KEY
WORKDIR /app
COPY apps/web apps/web
COPY infra/release/normalize-next-build.mjs infra/release/normalize-next-build.mjs
ARG NEXT_PUBLIC_API_URL
ARG RELEASE_BUILD_ID
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV RELEASE_BUILD_ID=${RELEASE_BUILD_ID}
ENV NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=${NEXT_SERVER_ACTIONS_ENCRYPTION_KEY}
RUN pnpm --filter @inventory-fastfood/web build && \
    node infra/release/normalize-next-build.mjs apps/web/.next apps/web/src && \
    find /app -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS runner
ARG OCI_REVISION
ARG OCI_CREATED
ARG OCI_VERSION
ARG RELEASE_BUILD_ID
ARG SOURCE_DATE_EPOCH
LABEL org.opencontainers.image.revision=$OCI_REVISION \
      org.opencontainers.image.created=$OCI_CREATED \
      org.opencontainers.image.version=$OCI_VERSION \
      org.opencontainers.image.title="2X1 Burger Co Web" \
      org.opencontainers.image.source="inventory-fastfood-system" \
      org.opencontainers.image.description="Inventory Fastfood web release artifact"
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1
ENV RELEASE_MANIFEST_PATH=/app/release-manifest.json
ENV RELEASE_BUILD_ID=$RELEASE_BUILD_ID
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
COPY .release/release-manifest.json /app/release-manifest.json
COPY infra/docker/web-runtime-url.mjs infra/docker/web-healthcheck.mjs infra/docker/web-entrypoint.sh /app/
RUN chmod 755 /app/web-entrypoint.sh && chown -R node:node /app && \
    find /app -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +
EXPOSE 3001
USER node
CMD ["/app/web-entrypoint.sh"]
