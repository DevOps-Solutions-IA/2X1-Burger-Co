FROM node:22-alpine AS base
RUN corepack enable

FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/web/tsconfig.json apps/web/tsconfig.json
COPY apps/web/next.config.ts apps/web/next.config.ts
COPY apps/web/postcss.config.mjs apps/web/postcss.config.mjs
COPY apps/web/tailwind.config.ts apps/web/tailwind.config.ts
COPY apps/web/next-env.d.ts apps/web/next-env.d.ts
RUN pnpm install --frozen-lockfile

FROM deps AS build
WORKDIR /app
COPY apps/web apps/web
ARG NEXT_PUBLIC_API_URL
ARG RELEASE_BUILD_ID
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV RELEASE_BUILD_ID=${RELEASE_BUILD_ID}
RUN pnpm --filter @inventory-fastfood/web build

FROM node:22-alpine AS runner
ARG OCI_REVISION
ARG OCI_CREATED
ARG OCI_VERSION
ARG RELEASE_BUILD_ID
LABEL org.opencontainers.image.revision=$OCI_REVISION \
      org.opencontainers.image.created=$OCI_CREATED \
      org.opencontainers.image.version=$OCI_VERSION \
      org.opencontainers.image.title="2X1 Burger Co Web" \
      org.opencontainers.image.source="inventory-fastfood-system" \
      org.opencontainers.image.description="Inventory Fastfood web release artifact"
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1
ENV RELEASE_MANIFEST_PATH=/app/release-manifest.json
ENV RELEASE_BUILD_ID=$RELEASE_BUILD_ID
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
COPY .release/release-manifest.json /app/release-manifest.json
RUN chown -R node:node /app
EXPOSE 3001
USER node
CMD ["node", "apps/web/server.js"]
