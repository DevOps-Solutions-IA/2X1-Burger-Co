generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductKind {
  PREPARED
  DIRECT_STOCK
}

enum ProductBrand {
  HOUSE
  COCA_COLA
  POSTOBON
  HIT
  OTHER
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum SaleChannel {
  MOSTRADOR
  PARA_LLEVAR
  MESA
  DOMICILIO
}

enum DiningTableStatus {
  FREE
  OCCUPIED
  RESERVED
  PAYMENT_PENDING
  OUT_OF_SERVICE
}

enum OrderTicketStatus {
  OPEN
  IN_PREPARATION
  SERVED
  PAYMENT_PENDING
  PAID
  CANCELLED
}

enum OrderTicketType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  COUNTER
}

enum DeliveryWorkflowStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  ISSUE
}

enum DeliveryLocationInboxStatus {
  PENDING
  APPLIED
  REQUIRES_REVIEW
  IGNORED
}

enum OperationalAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum OperationalAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum DeliveryIssueType {
  CUSTOMER_UNREACHABLE
  INCOMPLETE_ADDRESS
  LOCATION_MISMATCH
  PAYMENT_PENDING
  DELIVERY_REJECTED
  ROUTE_INCIDENT
  OTHER
}

enum DeliveryIssueStatus {
  OPEN
  RESOLVED
}

enum InventoryMovementType {
  INITIAL
  PURCHASE
  SALE
  ADJUSTMENT
  WASTE
  DAMAGE
  RETURN
  INTERNAL_USE
}

enum CashSessionStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum StockCountStatus {
  COMPLETED
  CANCELLED
}

enum StockCountScope {
  CRITICAL
  ALL
  PRODUCTS
  INGREDIENTS
}

enum CashMovementType {
  OPENING
  SALE
  EXPENSE
  OTHER_INCOME
  OTHER_EXPENSE
  ADJUSTMENT
  CLOSING
}

enum WhatsappConversationStatus {
  ACTIVE
  HUMAN_REQUIRED
  HUMAN_TAKEN
  SOFIA_PAUSED
  RESOLVED
  ARCHIVED
}

enum WhatsappMessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum WhatsappMessageType {
  TEXT
  AUDIO
  IMAGE
  DOCUMENT
  BUTTON
  INTERACTIVE
  SYSTEM
}

enum WhatsappInboundEventKind {
  INBOUND_MESSAGE
  STATUS_EVENT
  UNSUPPORTED_EVENT
}

enum WhatsappDeliveryStatus {
  ACCEPTED
  SENT
  DELIVERED
  READ
  FAILED
  UNKNOWN
}

enum WhatsappMediaSecurityStatus {
  METADATA_ONLY
  QUARANTINED
  REJECTED
  CLEARED
}

enum SofiaOrderDraftStatus {
  DRAFT
  NEEDS_INFO
  READY_TO_CONFIRM
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum SofiaPaymentPreference {
  UNKNOWN
  ONLINE
  CASH_ON_DELIVERY
  PAY_AT_PICKUP
}

enum SofiaCommandStatus {
  RECEIVED
  VALIDATED
  APPROVAL_REQUIRED
  APPROVED
  CLAIMED
  EXECUTING
  SUCCEEDED
  FAILED
  REJECTED
  EXPIRED
}

enum SofiaCommandApprovalStatus {
  APPROVED
  REVOKED
  EXPIRED
}

enum SofiaCommandAttemptOutcome {
  CLAIMED
  SUCCEEDED
  FAILED
  EXPIRED
}

enum SofiaCommandFailureClass {
  VALIDATION
  POLICY
  CONFLICT
  DEPENDENCY
  TIMEOUT
  UNKNOWN_RESULT
  INTERNAL
}

enum WhatsappDeliveryOrderStatus {
  CONFIRMED
  SENT_TO_KITCHEN
  IN_PREPARATION
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum WhatsappPaymentStatus {
  UNSELECTED
  CASH_ON_DELIVERY
  PENDING_MANUAL_VERIFICATION
  PENDING_ONLINE_PAYMENT
  MANUAL_REVIEW
  PAID
  FAILED
  CANCELLED
}

enum SofiaOrderSource {
  WHATSAPP
  SOFIA
  WHATSAPP_SOFIA
  MOCK_ADMIN
}

enum SofiaPromptStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SofiaCatalogItemType {
  OFFER
  PRODUCT
  ADDITION
  BEVERAGE
}

enum SofiaCatalogItemStatus {
  ACTIVE
  INACTIVE
}

enum SofiaCatalogPriceSource {
  PRODUCT
  MANUAL
  NONE
}

enum SofiaMemoryConsentState {
  UNKNOWN
  IMPLIED_BY_CONVERSATION
  OPTED_OUT
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum CustomerIdentityType {
  PHONE
}

enum CustomerConsentPurpose {
  MARKETING
  SERVICE
}

enum CustomerConsentChannel {
  WHATSAPP
  SMS
  PHONE
}

enum CustomerConsentStatus {
  GRANTED
  REVOKED
}

enum CustomerInteractionChannel {
  WHATSAPP
  PHONE
  IN_PERSON
  SYSTEM
}

enum CustomerInteractionDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum CustomerSegmentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CustomerCampaignStatus {
  DRAFT
  BLOCKED
  CANCELLED
}

enum CustomerCampaignDeliveryStatus {
  PENDING
  BLOCKED
  CANCELLED
}

model User {
  id                                 String                       @id @default(cuid())
  email                              String                       @unique
  passwordHash                       String
  fullName                           String
  accessName                         String?                      @unique @map("access_name")
  accessCodeHash                     String?                      @map("access_code_hash")
  sessionVersion                     Int                          @default(0) @map("session_version")
  isActive                           Boolean                      @default(true)
  lastLoginAt                        DateTime?
  createdAt                          DateTime                     @default(now())
  updatedAt                          DateTime                     @updatedAt
  roles                              UserRole[]
  assignedRoles                      UserRole[]                   @relation("UserRoleAssignedBy")
  refreshTokens                      RefreshToken[]
  purchases                          Purchase[]
  sales                              Sale[]
  orderTickets                       OrderTicket[]
  assignedOrderTickets               OrderTicket[]                @relation("OrderTicketAssignedWaiter")
  assignedDeliveryTickets            OrderTicket[]                @relation("OrderTicketAssignedRider")
  verifiedSofiaPayments              WhatsappDeliveryOrder[]      @relation("SofiaPaymentVerifiedBy")
  sofiaPaymentEvents                 SofiaPaymentEvent[]          @relation("SofiaPaymentEventActor")
  waiterTableGroupAssignments        WaiterTableGroupAssignment[] @relation("WaiterTableGroupAssignmentWaiter")
  createdWaiterTableGroupAssignments WaiterTableGroupAssignment[] @relation("WaiterTableGroupAssignmentAssignedBy")
  waiterTableAssignments             WaiterTableAssignment[]      @relation("WaiterTableAssignmentWaiter")
  createdWaiterTableAssignments      WaiterTableAssignment[]      @relation("WaiterTableAssignmentAssignedBy")
  openedSessions                     CashSession[]                @relation("CashSessionOpenedBy")
  closedSessions                     CashSession[]                @relation("CashSessionClosedBy")
  reopenedSessions                   CashSession[]                @relation("CashSessionReopenedBy")
  inventoryMoves                     InventoryMovement[]          @relation("InventoryMovementPerformedBy")
  cashMovements                      CashMovement[]               @relation("CashMovementCreatedBy")
  expenses                           Expense[]
  reports                            ReportSnapshot[]
  auditLogs                          AuditLog[]
  supplierNotifications              SupplierNotification[]       @relation("SupplierNotificationCreatedBy")
  stockCounts                        StockCountSession[]          @relation("StockCountCreatedBy")
  approvedStockCounts                StockCountSession[]          @relation("StockCountApprovedBy")
  saleConversions                    SaleConversion[]
  waiterSyncReceipts                 WaiterOrderSyncReceipt[]
  createdOperationalAlerts           OperationalAlert[]           @relation("OperationalAlertActor")
  resolvedOperationalAlerts          OperationalAlert[]           @relation("OperationalAlertResolvedBy")
  reportedDeliveryIssues             DeliveryIssue[]              @relation("DeliveryIssueReportedBy")
  resolvedDeliveryIssues             DeliveryIssue[]              @relation("DeliveryIssueResolvedBy")
  assignedWhatsappConversations      WhatsappConversation[]       @relation("WhatsappConversationAssignedTo")
  approvedWhatsappOutboundMessages   WhatsappOutboundMessage[]    @relation("WhatsappOutboundApprovedBy")
  whatsappHandoffEvents              WhatsappHandoffEvent[]       @relation("WhatsappHandoffActor")

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  id           String   @id @default(cuid())
  userId       String
  roleId       String
  assignedById String?
  assignedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User?    @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Unit {
  id           String       @id @default(cuid())
  name         String
  code         String       @unique
  abbreviation String       @unique
  description  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  products     Product[]
  ingredients  Ingredient[]

  @@map("units")
}

model Supplier {
  id            String                 @id @default(cuid())
  name          String
  taxId         String?                @unique
  contactName   String?
  phone         String?
  email         String?
  address       String?
  isActive      Boolean                @default(true)
  notes         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  purchases     Purchase[]
  notifications SupplierNotification[]

  @@index([name])
  @@map("suppliers")
}

model Product {
  id            String              @id @default(cuid())
  code          String              @unique
  name          String
  description   String?
  imageUrl      String?
  categoryId    String
  unitId        String
  kind          ProductKind
  brand         ProductBrand        @default(HOUSE)
  salePrice     Decimal             @db.Decimal(10, 2)
  costPrice     Decimal?            @db.Decimal(10, 2)
  trackStock    Boolean             @default(true)
  currentStock  Decimal             @default(0) @db.Decimal(10, 3)
  stockMin      Decimal?            @db.Decimal(10, 3)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  category      Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit          Unit                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  recipes       Recipe[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  orderItems    OrderTicketItem[]
  movements     InventoryMovement[]
  stockCounts   StockCountItem[]

  @@index([currentStock])
  @@index([categoryId])
  @@index([brand])
  @@index([kind])
  @@index([isActive])
  @@map("products")
}

model Ingredient {
  id            String              @id @default(cuid())
  code          String              @unique
  name          String
  description   String?
  unitId        String
  costPrice     Decimal?            @db.Decimal(10, 2)
  stockMin      Decimal?            @db.Decimal(10, 3)
  stockMax      Decimal?            @db.Decimal(10, 3)
  currentStock  Decimal             @default(0) @db.Decimal(10, 3)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  unit          Unit                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  purchaseItems PurchaseItem[]
  recipeItems   RecipeItem[]
  movements     InventoryMovement[]
  stockCounts   StockCountItem[]

  @@index([isActive])
  @@map("ingredients")
}

model Recipe {
  id            String       @id @default(cuid())
  productId     String       @unique
  name          String?
  yieldQuantity Decimal      @default(1) @db.Decimal(10, 3)
  instructions  String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  items         RecipeItem[]

  @@map("recipes")
}

model RecipeItem {
  id           String     @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Decimal    @db.Decimal(10, 3)
  wastePercent Decimal    @default(0) @db.Decimal(5, 2)
  notes        String?
  createdAt    DateTime   @default(now())
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_items")
}

model Purchase {
  id              String         @id @default(cuid())
  number          String         @unique
  supplierId      String
  paymentMethodId String?
  cashSessionId   String?
  status          PurchaseStatus @default(RECEIVED)
  invoiceNumber   String?
  subtotal        Decimal        @default(0) @db.Decimal(12, 2)
  tax             Decimal        @default(0) @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @default(0) @db.Decimal(12, 2)
  notes           String?
  purchasedAt     DateTime       @default(now())
  receivedAt      DateTime?
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  cashSession     CashSession?   @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  createdBy       User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items           PurchaseItem[]

  @@index([supplierId])
  @@index([paymentMethodId])
  @@index([cashSessionId])
  @@index([purchasedAt])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id           String      @id @default(cuid())
  purchaseId   String
  ingredientId String?
  productId    String?
  quantity     Decimal     @db.Decimal(10, 3)
  unitCost     Decimal     @db.Decimal(10, 2)
  totalCost    Decimal     @db.Decimal(12, 2)
  expirationAt DateTime?
  lotNumber    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  purchase     Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  product      Product?    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([ingredientId])
  @@index([productId])
  @@map("purchase_items")
}

model InventoryMovement {
  id            String                @id @default(cuid())
  ingredientId  String?
  productId     String?
  type          InventoryMovementType
  quantity      Decimal               @db.Decimal(10, 3)
  unitCost      Decimal?              @db.Decimal(10, 2)
  balanceAfter  Decimal?              @db.Decimal(10, 3)
  referenceType String?
  referenceId   String?
  notes         String?
  performedById String?
  occurredAt    DateTime              @default(now())
  createdAt     DateTime              @default(now())
  ingredient    Ingredient?           @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  product       Product?              @relation(fields: [productId], references: [id], onDelete: Restrict)
  performedBy   User?                 @relation("InventoryMovementPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([ingredientId])
  @@index([productId])
  @@index([occurredAt])
  @@map("inventory_movements")
}

model Sale {
  id                         String          @id @default(cuid())
  number                     String          @unique
  status                     SaleStatus      @default(PAID)
  channel                    SaleChannel     @default(MOSTRADOR)
  tableLabel                 String?
  deliveryReference          String?
  customerPhone              String?
  deliveryFee                Decimal         @default(0) @db.Decimal(12, 2)
  deliveryFeeSuggested       Decimal?        @map("delivery_fee_suggested") @db.Decimal(12, 2)
  deliveryFeeEdited          Boolean         @default(false) @map("delivery_fee_edited")
  deliveryFeeEditReason      String?         @map("delivery_fee_edit_reason")
  deliveryDistanceKm         Decimal?        @db.Decimal(8, 3)
  deliveryZoneLabel          String?
  deliveryPricingBreakdown   Json?           @map("delivery_pricing_breakdown")
  deliveryCalculationVersion String?         @map("delivery_calculation_version")
  customerName               String?
  subtotal                   Decimal         @default(0) @db.Decimal(12, 2)
  tax                        Decimal         @default(0) @db.Decimal(12, 2)
  discount                   Decimal         @default(0) @db.Decimal(12, 2)
  total                      Decimal         @default(0) @db.Decimal(12, 2)
  notes                      String?
  soldAt                     DateTime        @default(now())
  createdById                String
  cashSessionId              String?
  orderTicketId              String?         @unique
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  createdBy                  User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  cashSession                CashSession?    @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  orderTicket                OrderTicket?    @relation(fields: [orderTicketId], references: [id], onDelete: SetNull)
  items                      SaleItem[]
  payments                   SalePayment[]
  conversion                 SaleConversion?

  @@index([soldAt])
  @@index([channel])
  @@index([cashSessionId])
  @@index([orderTicketId])
  @@index([createdById])
  @@map("sales")
}

model SaleConversion {
  id            String      @id @default(cuid())
  saleId        String      @unique
  orderTicketId String      @unique
  reason        String
  convertedById String
  convertedAt   DateTime    @default(now())
  createdAt     DateTime    @default(now())
  sale          Sale        @relation(fields: [saleId], references: [id], onDelete: Restrict)
  orderTicket   OrderTicket @relation(fields: [orderTicketId], references: [id], onDelete: Restrict)
  convertedBy   User        @relation(fields: [convertedById], references: [id], onDelete: Restrict)

  @@index([convertedAt])
  @@index([convertedById])
  @@map("sale_conversions")
}

model SaleItem {
  id            String   @id @default(cuid())
  saleId        String
  productId     String
  quantity      Decimal  @db.Decimal(10, 3)
  unitPrice     Decimal  @db.Decimal(10, 2)
  totalPrice    Decimal  @db.Decimal(12, 2)
  estimatedCost Decimal? @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime @default(now())
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@map("sale_items")
}

model SalePayment {
  id              String        @id @default(cuid())
  saleId          String
  paymentMethodId String
  amount          Decimal       @db.Decimal(12, 2)
  receivedAmount  Decimal?      @map("received_amount") @db.Decimal(12, 2)
  changeAmount    Decimal?      @map("change_amount") @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@index([paymentMethodId])
  @@map("sale_payments")
}

model PaymentMethod {
  id        String         @id @default(cuid())
  name      String
  code      String         @unique
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  sales     SalePayment[]
  expenses  Expense[]
  movements CashMovement[]
  purchases Purchase[]

  @@map("payment_methods")
}

model CashSession {
  id                    String            @id @default(cuid())
  status                CashSessionStatus @default(OPEN)
  openedById            String
  closedById            String?
  openingAmount         Decimal           @db.Decimal(12, 2)
  closingAmount         Decimal?          @db.Decimal(12, 2)
  expectedAmount        Decimal?          @db.Decimal(12, 2)
  difference            Decimal?          @db.Decimal(12, 2)
  notes                 String?
  openedAt              DateTime          @default(now())
  closedAt              DateTime?
  reopenedAt            DateTime?
  reopenReason          String?           @map("reopen_reason")
  reopenedFromSessionId String?           @map("reopened_from_session_id")
  reopenedById          String?           @map("reopened_by_id")
  openingBreakdown      Json?             @map("opening_breakdown")
  closingBreakdown      Json?             @map("closing_breakdown")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  openedBy              User              @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy              User?             @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  reopenedBy            User?             @relation("CashSessionReopenedBy", fields: [reopenedById], references: [id], onDelete: SetNull)
  reopenedFromSession   CashSession?      @relation("CashSessionReopenChain", fields: [reopenedFromSessionId], references: [id], onDelete: SetNull)
  reopenedSessions      CashSession[]     @relation("CashSessionReopenChain")
  sales                 Sale[]
  orderTickets          OrderTicket[]
  movements             CashMovement[]
  expenses              Expense[]
  purchases             Purchase[]

  @@index([status])
  @@index([openedAt])
  @@map("cash_sessions")
}

model DiningTable {
  id                String                  @id @default(cuid())
  label             String                  @unique
  area              String?
  groupId           String?                 @map("group_id")
  capacity          Int                     @default(2)
  status            DiningTableStatus       @default(FREE)
  isActive          Boolean                 @default(true)
  notes             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  group             TableGroup?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  orderTickets      OrderTicket[]
  waiterAssignments WaiterTableAssignment[]

  @@index([groupId])
  @@index([status, isActive])
  @@map("dining_tables")
}

model TableGroup {
  id          String                       @id @default(cuid())
  name        String                       @unique
  description String?
  area        String?
  color       String?
  isActive    Boolean                      @default(true) @map("is_active")
  createdAt   DateTime                     @default(now()) @map("created_at")
  updatedAt   DateTime                     @updatedAt @map("updated_at")
  tables      DiningTable[]
  assignments WaiterTableGroupAssignment[]

  @@index([isActive])
  @@map("table_groups")
}

model WaiterTableGroupAssignment {
  id           String     @id @default(cuid())
  waiterId     String     @map("waiter_id")
  tableGroupId String     @map("table_group_id")
  isActive     Boolean    @default(true) @map("is_active")
  assignedAt   DateTime   @default(now()) @map("assigned_at")
  assignedById String?    @map("assigned_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  waiter       User       @relation("WaiterTableGroupAssignmentWaiter", fields: [waiterId], references: [id], onDelete: Cascade)
