  account               WhatsappProviderAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  outboundMessage       WhatsappOutboundMessage? @relation(fields: [outboundMessageId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  message               WhatsappMessage?         @relation(fields: [messageId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([accountId, providerStatusEventId])
  @@index([accountId, providerMessageId, occurredAt])
  @@index([outboundMessageId, occurredAt])
  @@index([status, occurredAt])
  @@map("whatsapp_message_status_events")
}

model WhatsappHandoffEvent {
  id             String               @id @default(cuid())
  conversationId String               @map("conversation_id")
  actorId        String               @map("actor_id")
  previousState  String               @map("previous_state")
  nextState      String               @map("next_state")
  reasonCode     String               @map("reason_code")
  version        Int
  createdAt      DateTime             @default(now()) @map("created_at")
  conversation   WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor          User                 @relation("WhatsappHandoffActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([conversationId, version])
  @@index([actorId, createdAt])
  @@index([nextState, createdAt])
  @@map("whatsapp_handoff_events")
}

model WhatsappMediaEnvelope {
  id                    String                      @id @default(cuid())
  messageId             String                      @unique @map("message_id")
  providerReferenceHash String                      @map("provider_reference_hash")
  declaredMimeType      String?                     @map("declared_mime_type")
  detectedMimeType      String?                     @map("detected_mime_type")
  declaredSizeBytes     BigInt?                     @map("declared_size_bytes")
  securityStatus        WhatsappMediaSecurityStatus @default(METADATA_ONLY) @map("security_status")
  rejectionCode         String?                     @map("rejection_code")
  expiresAt             DateTime                    @map("expires_at")
  createdAt             DateTime                    @default(now()) @map("created_at")
  message               WhatsappMessage             @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([securityStatus, expiresAt])
  @@map("whatsapp_media_envelopes")
}

model SofiaCommandApproval {
  id                    String                     @id @default(cuid())
  commandId             String                     @map("command_id")
  approverActorId       String                     @map("approver_actor_id")
  approverRolesSnapshot Json                       @map("approver_roles_snapshot")
  approvalAction        String                     @map("approval_action")
  status                SofiaCommandApprovalStatus @default(APPROVED)
  payloadHash           String                     @map("payload_hash")
  expectedVersion       String?                    @map("expected_version")
  targetType            String                     @map("target_type")
  targetId              String?                    @map("target_id")
  source                String
  grantedAt             DateTime                   @default(now()) @map("granted_at")
  expiresAt             DateTime                   @map("expires_at")
  revokedAt             DateTime?                  @map("revoked_at")
  reasonCode            String                     @map("reason_code")
  policyReference       String                     @map("policy_reference")
  auditIdentity         String                     @unique @map("audit_identity")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @default(now()) @updatedAt @map("updated_at")
  version               Int                        @default(0)
  command               SofiaCommand               @relation(fields: [commandId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  attempts              SofiaCommandAttempt[]

  @@index([commandId, status, expiresAt])
  @@index([approverActorId, grantedAt])
  @@index([status, expiresAt])
  @@map("sofia_command_approvals")
}

model SofiaCommandAttempt {
  id             String                     @id @default(cuid())
  commandId      String                     @map("command_id")
  approvalId     String?                    @map("approval_id")
  attemptNumber  Int                        @map("attempt_number")
  claimOwnerHash String                     @map("claim_owner_hash")
  leaseExpiresAt DateTime                   @map("lease_expires_at")
  startedAt      DateTime                   @default(now()) @map("started_at")
  finishedAt     DateTime?                  @map("finished_at")
  releaseVersion String                     @map("release_version")
  outcome        SofiaCommandAttemptOutcome @default(CLAIMED)
  failureClass   SofiaCommandFailureClass?  @map("failure_class")
  retryable      Boolean                    @default(false)
  errorCode      String?                    @map("error_code")
  createdAt      DateTime                   @default(now()) @map("created_at")
  command        SofiaCommand               @relation(fields: [commandId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  approval       SofiaCommandApproval?      @relation(fields: [approvalId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([commandId, attemptNumber])
  @@index([commandId, startedAt])
  @@index([outcome, startedAt])
  @@index([leaseExpiresAt, outcome])
  @@index([approvalId])
  @@map("sofia_command_attempts")
}

model SofiaCommandResult {
  id                 String       @id @default(cuid())
  commandId          String       @unique @map("command_id")
  resultCode         String       @map("result_code")
  sanitizedPayload   Json         @map("sanitized_payload")
  resultHash         String       @map("result_hash")
  domainReferenceIds Json?        @map("domain_reference_ids")
  completedAt        DateTime     @default(now()) @map("completed_at")
  redactionVersion   Int          @default(1) @map("redaction_version")
  retentionUntil     DateTime     @map("retention_until")
  createdAt          DateTime     @default(now()) @map("created_at")
  command            SofiaCommand @relation(fields: [commandId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([retentionUntil])
  @@map("sofia_command_results")
}

model ExternalApiCache {
  id           String   @id @default(cuid())
  provider     String
  cacheType    String   @map("cache_type")
  cacheKey     String   @map("cache_key")
  requestHash  String   @map("request_hash")
  responseJson Json     @map("response_json")
  status       String
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([provider, cacheType, cacheKey])
  @@index([expiresAt])
  @@index([provider])
  @@index([cacheType])
  @@index([status])
  @@map("external_api_cache")
}

model DeliveryProviderUsage {
  id               String    @id @default(cuid())
  provider         String
  endpoint         String
  usageDate        DateTime  @map("usage_date") @db.Date
  requestCount     Int       @default(0) @map("request_count")
  successCount     Int       @default(0) @map("success_count")
  errorCount       Int       @default(0) @map("error_count")
  lastStatus       String?   @map("last_status")
  lastErrorCode    String?   @map("last_error_code")
  lastErrorAt      DateTime? @map("last_error_at")
  circuitOpenUntil DateTime? @map("circuit_open_until")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([provider, endpoint, usageDate])
  @@index([provider])
  @@index([endpoint])
  @@index([usageDate])
  @@index([circuitOpenUntil])
  @@map("delivery_provider_usage")
}

model DeliveryPricingAudit {
  id                  String            @id @default(cuid())
  orderTicketId       String?           @map("order_ticket_id")
  saleId              String?           @map("sale_id")
  customerId          String?           @map("customer_id")
  operatorId          String?           @map("operator_id")
  requestJson         Json              @map("request_json")
  resultJson          Json              @map("result_json")
  suggestedFee        Decimal?          @map("suggested_fee") @db.Decimal(12, 2)
  finalFee            Decimal?          @map("final_fee") @db.Decimal(12, 2)
  manualEdited        Boolean           @default(false) @map("manual_edited")
  manualEditReason    String?           @map("manual_edit_reason")
  calculationVersion  String            @map("calculation_version")
  providerSummaryJson Json?             @map("provider_summary_json")
  createdAt           DateTime          @default(now()) @map("created_at")
  sofiaOrderDrafts    SofiaOrderDraft[] @relation("SofiaOrderDraftDeliveryQuote")

  @@index([orderTicketId])
  @@index([saleId])
  @@index([customerId])
  @@index([operatorId])
  @@index([createdAt])
  @@map("delivery_pricing_audits")
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  category    String?
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("settings")
}
